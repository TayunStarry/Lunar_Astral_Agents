{
	"name": "lunar-core",
	"version": "4.0.0",
	"type": "module",
	"description": "月华 - 您专属的本地智能 AI 少女助理",
	"main": "index.html",
	"scripts": {
		"release.min": "tsc && rollup -c",
		"ltp": "node script/run-generate-tool.js",

		"compile.server": "tsc ./server.side/index.ts --removeComments --moduleResolution node --target es2022 --outDir ./node_modules/deliverable",
		"server.side": "npm run compile.server && rollup ./node_modules/deliverable/index.js --file ./hierarchy/assets/agentSystem.js"
	},
	"keywords": [
		"ai",
		"chatbot",
		"live2d",
		"typescript"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@types/node": "^20.19.39",
		"rollup": "^4.55.1",
		"typescript": "^5.0.0"
	}
}
