{
	"models": {
		"default_scheme": "quality",
		"schemes": {
			"turbo": {
				"label": "速度优先",
				"diffusion_model": "./local_data/models/Qwen-image-2.1/qwen-image-2.1-turbo-Q4_K_M.gguf",
				"variational_model": "./local_data/models/Qwen-image-2.1/qwen_image_2.1_vae_bf16.safetensors",
				"prompt_analysis_model": "./local_data/models/Qwen-image-2.1/Qwen3-VL-8B-Instruct-Q4_K_M.gguf",
				"prompt_mmproj_model": null,
				"real_esrgan_model": "./local_data/models/4x-AnimeSharp.pth",
				"steps": 8
			},
			"quality": {
				"label": "质量优先",
				"diffusion_model": "./local_data/models/Qwen-image-2.1/qwen-image-2.1-Q4_K_M.gguf",
				"variational_model": "./local_data/models/Qwen-image-2.1/qwen_image_2.1_vae_bf16.safetensors",
				"prompt_analysis_model": "./local_data/models/Qwen-image-2.1/Qwen3-VL-8B-Instruct-Q4_K_M.gguf",
				"prompt_mmproj_model": null,
				"real_esrgan_model": "./local_data/models/4x-AnimeSharp.pth",
				"steps": 40
			}
		}
	},
	"system": {
		"developer": false,
		"allow_lan": false,
		"insecure_tls": false,
		"console_log": false,
		"chat_vram_guard": true,
		"chat_vram_guard_mib": 1024,
		"chat_vram_guard_interval": 16,
		"character_renderer": "live2d",
		"loop_node_runes": 1024,
		"loop_segment_runes": 128,
		"loop_similarity": 0.65,
		"-enumerate": [
			"bedrock",
			"live2d"
		]
	},
	"agent": {
		"user_name": "钛宇星光阁",
		"embedding_model": "system-embedding",
		"embedding_url": "http://127.0.0.1:36789/v1",
		"embedding_key": null,
		"multimodal_model": "system-multimodal",
		"multimodal_url": "http://127.0.0.1:36789/v1",
		"multimodal_key": null,
		"video_input": "file",
		"image_input": "url",
		"vision_max_side": 1024,
		"vision_cache_cap_mb": 512,
		"append_settings": []
	},
	"diffusion": {
		"allow_diffusion": true,
		"image_vram_guard": true,
		"image_vram_guard_mib": 8192,
		"sd_offload_to_cpu": "always",
		"sd_te_on_cpu": true,
		"sd_vae_tiling": "off",
		"sd_vae_tile_size": null,
		"sd_vae_tile_overlap": 0,
		"sd_max_vram": null,
		"sd_sampler": "auto",
		"sd_scheduler": "auto",
		"sd_flow_shift": 0,
		"sd_diffusion_fa": true,
		"sd_steps": 40,
		"sd_image_size": 1024
	},
	"tts": {
		"engine": "Qwen",
		"-enumerate": [
			"Qwen",
			"Kokoro",
			"OmniVoice"
		],
		"ref_audio": "./local_data/audios/lunar-template.wav",
		"ref_text": null,
		"voice": null,
		"mix": null,
		"speed": 1,
		"lang": null,
		"instruct": null,
		"seed": 0,
		"disable_postproc": false,
		"idle_unload_minutes": 5
	},
	"web_search": {
		"search_model": "system-search",
		"swap_model": true,
		"max_pages": 5,
		"max_results": 15,
		"summary_max_chars": 4096,
		"max_run_seconds": 420
	},
	"release": {
		"gitee_owner": "TayunStarry",
		"gitee_repo": "Lunar-Astral-Agents",
		"include": [
			"local_data/audios",
			"local_data/multimedia/background",
			"local_data/multimedia/icon",
			"local_data/multimedia/placeholder",
			"local_data/package",
			"local_data/lunar_config.json"
		],
		"program_files": [
			"Lunar_Astral_Agents.exe",
			"Lunar_Update_Applier.exe"
		],
		"exclude_dirs_with": [
			"metadata.json"
		],
		"backup_keep": 3,
		"restart_args": [],
		"target_dir": ".",
		"package_dir": "local_data/package"
	}
}